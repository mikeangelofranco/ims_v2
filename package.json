{
  "name": "ims-v2",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm run build:fonts && npm run build:css && npm run build:js",
    "build:fonts": "mkdir -p static/fonts && cp node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 static/fonts/inter-latin-wght-normal.woff2",
    "build:css": "tailwindcss -i static/src/app.css -o static/css/app.css --minify",
    "build:js": "esbuild static/src/app.js --bundle --minify --outfile=static/js/app.js",
    "dev": "npm run build:fonts && node scripts/watch-assets.mjs",
    "dev:css": "tailwindcss -i static/src/app.css -o static/css/app.css --watch=always",
    "dev:js": "esbuild static/src/app.js --bundle --outfile=static/js/app.js --watch=forever"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "htmx.org": "^2.0.0",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.0"
  }
}
