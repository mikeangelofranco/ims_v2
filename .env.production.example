DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=plughubcore.com,.plughubcore.com
CSRF_TRUSTED_ORIGINS=https://plughubcore.com,https://*.plughubcore.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ims_v2
DB_CONN_MAX_AGE=60
DJANGO_LOG_LEVEL=INFO
TENANT_BASE_DOMAIN=plughubcore.com
WORKSPACE_DISPLAY_DOMAIN=plughubcore.com
TENANCY_PLATFORM_HOSTS=plughubcore.com,www.plughubcore.com
SESSION_COOKIE_DOMAIN=.plughubcore.com
CSRF_COOKIE_DOMAIN=.plughubcore.com
